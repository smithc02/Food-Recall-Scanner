# Copy to .env and replace every value with local development-only values.
POSTGRES_USER=REPLACE_WITH_LOCAL_USER
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LOCAL_REDIS_PASSWORD
# Use the same values above when constructing these service URLs.
DATABASE_URL=postgresql://REPLACE_WITH_LOCAL_USER:REPLACE_WITH_LOCAL_POSTGRES_PASSWORD@127.0.0.1:5432/food_recall
REDIS_URL=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
